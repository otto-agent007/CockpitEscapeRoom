{
  "name": "cockpit-escape-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "assets:check": "node tools/assets/check-models.mjs && node tools/assets/check-intro-assets.mjs",
    "references:validate": "python3 tools/references/validate_manifest.py",
    "references:download": "python3 tools/references/download_references.py",
    "references:contact-sheet": "python3 tools/references/build_contact_sheet.py",
    "references:brief": "python3 tools/references/generate_modeling_brief.py",
    "references:check": "python3 tools/references/check_references.py",
    "pipeline:evals": "python3 -m tools.blender.cockpit_pipeline.pipeline_cli run-evals",
    "asset:tmb2-ident": "python3 tools/assets/build-tmb2-ident-assets.py && node tools/assets/build-intro-manifest.mjs",
    "asset:tmb2-emblem": "python3 tools/assets/build-intro-emblem.py && node tools/assets/build-intro-manifest.mjs",
    "asset:dc9": "node tools/assets/build-asset.mjs dc9",
    "asset:dc9-memphis": "node tools/assets/build-asset.mjs dc9-memphis",
    "asset:dc9-memphis:intake": "node tools/assets/dc9-memphis-source-contract.mjs --source-dir .cache/cockpit-pipeline/sources/dc9-memphis/ted-davis-memphis-nashville --output asset-reports/dc9-memphis-source-intake.json",
    "asset:airbus": "node tools/assets/build-asset.mjs airbus",
    "asset:airbus:promote-gate": "python3 tools/blender/promote_airbus_captain_gate.py",
    "asset:tesla": "node tools/assets/build-asset.mjs tesla",
    "asset:locker": "node tools/assets/build-asset.mjs locker"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.9"
  }
}
